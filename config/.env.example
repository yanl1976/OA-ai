# ===== 本地知识库运行配置 =====
# 部署位置：/opt/OA-ai/.env（部署根目录，与 scripts/ 同级）
#
# 【优先级】本文件是最高配置源。serve.py 启动时以 override=True 加载它，
# 其取值会覆盖 systemd unit 里的 Environment= 与 shell 环境变量。
# 因此端口等运行参数【只改这里】即可，改完 `systemctl restart kb` 生效。

# ===== 服务监听（端口统一管理处） =====
# 修改端口只需改本文件的 KB_API_PORT，然后 systemctl restart kb
KB_API_HOST=0.0.0.0
KB_API_PORT=8080

# ===== 知识库根目录 =====
# 【重要】这里必须是【部署根】，即包含 scripts/ 的那一层（/opt/OA-ai）。
# 代码会自动在其下拼接 knowledge_base/、data/、web_vue/dist/ 等子目录。
# 【切勿】填成 /opt/OA-ai/knowledge_base —— 会导致路径二次叠加成
#        /opt/OA-ai/knowledge_base/knowledge_base，索引与文档全部找不着。
#        （serve.py 已加防御：检测到非法值会自动回退并打印警告）
KB_ROOT=/opt/OA-ai

# 检索返回条数
KB_TOP_K=5

# ===== 初始管理员口令（可选，强烈建议配置） =====
# 【安全】源码与文档中不含任何明文口令。首次建库（data/kb_admin.db 不存在）时：
#   配置了本项  -> 用它作为 admin 初始口令
#   未配置      -> 随机生成强口令，打印到服务启动日志，并写入
#                  data/initial_admin_password.txt（data/ 已被 .gitignore 排除）
# 注意：本项【只在首次建库时生效】，不会覆盖已有 admin 账号。
#       修改/重置已有账号请用：python scripts/reset_admin_password.py --random
# KB_ADMIN_USER=admin
# KB_ADMIN_PASS=请填写一个足够强的口令

# ===== 企业微信自建回调服务（可选，启用双向交互时使用） =====
# 在企业微信管理后台「企业内部应用」获取以下凭证
# WECCORP_CORPID=wwxxxxxxxxxxxxxxxx
# WECCORP_CORPSECRET=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# WECCORP_AGENTID=1000002
# WECCORP_TOKEN=your_callback_token
# WECCORP_AESKEY=your_encoding_aeskey
# WECCORP_CALLBACK_URL=https://your.domain.com/wecom/callback

# ===== 邮件系统配置（可选，用于通知推送） =====
# 邮件服务类型：smtp（标准）/ qq / 126 / 163（后三者仅作 UI 提示，底层均为 SMTP）
# EMAIL_TYPE=smtp
# 总开关：1 启用 / 0 停用。两个通知开关独立控制，须总开关开启且对应开关开启才发送。
# EMAIL_ENABLED=1
# EMAIL_HOST=smtp.qq.com
# EMAIL_PORT=465
# EMAIL_USER=123456@qq.com
# 【安全】此处填 SMTP 授权码（非邮箱登录密码）。改动后由「系统设置→邮件配置」卡片写回，
#       请勿在 git 跟踪文件中保留明文，生产环境通过 .env 注入。
# EMAIL_PASSWORD=
# 收件人，多个用逗号分隔：a@qq.com,b@163.com
# EMAIL_TO=
# 通知开关：云之家拉取内容更新通知 / 用户注册审核通知
# EMAIL_NOTIFY_PULL=0
# EMAIL_NOTIFY_REGISTER=0
