# Python
__pycache__/
*.pyc
*.pyo
venv/
.venv/

# Node
web_vue/node_modules/
web_vue/dist/

# 敏感数据（本地数据库与加密密钥，切勿上传）
data/

# 知识库运行时产物（install.sh 会自动重建索引）
knowledge_base/bm25_index/
knowledge_base/vec_index/
knowledge_base/upload/
knowledge_base/uploads/

# 知识库派生/备份数据（非源码，不入库）
knowledge_base/derived_minutes.json
knowledge_base/*.bak_*

# 环境配置（真实 .env 含凭证，切勿上传）
.env
.env.bak
# 带时间戳的备份（如 .env.bak_20260828_175522）同样含明文密钥，必须一并排除
.env.bak*
config/.env
config/.env.*
# 任何目录下的 .env（如 knowledge_base/.env），防止子目录配置被误入库
**/.env
!.env.example
!config/.env.example
# 云之家拉取：任务配置需入版本库（须能随 git 同步到各环境，
# 否则开发机改的配置永远到不了生产机，会出现「开发机拉全部、生产机只拉 N 条」的偏差）；
# 去重记录 .yzj_pull_synced.json 才是运行时本地状态，保持忽略、各环境独立。
config/.yzj_pull_synced.json

# 索引重建前的本地备份（_backup_index_<时间戳>/）。
# 曾误入库：生产部署时不上传该目录，git 便认为文件被删除（D），
# 导致工作区永久变脏、git pull 失败。故从版本库移除并永久忽略。
_backup_index_*/

# 运行时缓存
.jieba_cache/

# 临时调试 / 诊断文件
_t/
__diag_out.pdf
__test_derived.pdf

# IDE / 系统
.vscode/
.idea/
.DS_Store
Thumbs.db
